            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/game.css\");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from \"/@vite/client\"\nconst __vite__id = \"C:/Users/phung/THESIS/Official_Thesis/3DMuseum/game.css\"\nconst __vite__css = \"canvas{\\r\\n    display: block;\\r\\n}\\r\\n/* Loading Container */\\r\\n.loading-container {\\r\\n    display: none;\\r\\n    position: fixed;\\r\\n    top: 0;\\r\\n    left: 0;\\r\\n    width: 100%;\\r\\n    height: 100%;\\r\\n    background-color: rgba(0, 0, 0, 0.8);\\r\\n    color: white;\\r\\n    display: flex; /* Initially flex to show */\\r\\n    flex-direction: column;\\r\\n    justify-content: center;\\r\\n    align-items: center;\\r\\n    z-index: 1000;\\r\\n}\\r\\n\\r\\n#loading-bar {\\r\\n    width: 300px;\\r\\n    height: 20px;\\r\\n    background-color: #555;\\r\\n    border-radius: 10px;\\r\\n    overflow: hidden;\\r\\n    margin-bottom: 20px;\\r\\n}\\r\\n\\r\\n#progress {\\r\\n    height: 100%;\\r\\n    width: 0%; /* Initial width, updated by JS */\\r\\n    background-color: #4CAF50;\\r\\n    border-radius: 10px;\\r\\n}\\r\\n\\r\\n/* Menu Container */\\r\\n.menu-container {\\r\\n    position: fixed;\\r\\n    margin: 50%;\\r\\n    width: 50%;\\r\\n    height: 50%;\\r\\n    background-color: rgba(255, 255, 255, 0.9);\\r\\n    display: none; /* Hidden by default, shown by JS */\\r\\n    flex-direction: column;\\r\\n    align-items: center;\\r\\n    justify-self: center;\\r\\n    align-self: center;\\r\\n    padding: 20px;\\r\\n    box-sizing: border-box;\\r\\n    z-index: 999;\\r\\n    overflow-y: auto; /* Enable scrolling if content overflows */\\r\\n    background: rgba(36, 36, 36, 0.56);\\r\\n    border-radius: 16px;\\r\\n    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);\\r\\n    -webkit-backdrop-filter: blur(2.1px);\\r\\n    backdrop-filter: blur(2.1px);\\r\\n    border: 1px solid rgb(52, 50, 50);\\r\\n}\\r\\n\\r\\n.menu-container .flex {\\r\\n    width: 100%;\\r\\n    justify-content: flex-end; /* Aligns the close icon to the right */\\r\\n}\\r\\n\\r\\n.menu-container h2 {\\r\\n    margin-top: 0;\\r\\n    margin-bottom: 20px;\\r\\n    color: #333;\\r\\n}\\r\\n\\r\\n.menu-container hr {\\r\\n    width: 80%;\\r\\n    border: none;\\r\\n    border-top: 1px solid #ccc;\\r\\n    margin-top: 30px; /* Specific margin from HTML */\\r\\n}\\r\\n\\r\\n#menu-close {\\r\\n    font-size: 2rem;\\r\\n    cursor: pointer;\\r\\n    width: 2.5rem;\\r\\n    height: 2.5rem;\\r\\n    display: flex;\\r\\n    padding: .28rem;\\r\\n}\\r\\n\\r\\n#menu-close:hover {\\r\\n    background-color: rgb(182, 174, 160);\\r\\n    transform: rotateZ(180deg);\\r\\n    transition: 0.5s ease-out;\\r\\n}\\r\\n\\r\\n\\r\\n#menu-selection-list {\\r\\n    display: flex;\\r\\n    flex-direction: column;\\r\\n    align-items: center;\\r\\n    justify-content: center;\\r\\n    gap: 10px;\\r\\n    width: 80%;\\r\\n    margin-top: 20px;\\r\\n}\\r\\n\\r\\n.menu-item {\\r\\n    padding: 10px 15px;\\r\\n    background-color: #f0f0f0;\\r\\n    width: 50%;\\r\\n    height: auto;\\r\\n    border-radius: 5px;\\r\\n    cursor: pointer;\\r\\n    font-size: 12px;\\r\\n    text-align: center;\\r\\n    transition: background-color 0.3s ease;\\r\\n}\\r\\n\\r\\n.menu-item:hover {\\r\\n    background-color: #e0e0e0;\\r\\n}\\r\\n\\r\\n.menu-container ul {\\r\\n    list-style: none;\\r\\n    padding: 0;\\r\\n    margin: 0;\\r\\n    font-size: 14px;\\r\\n    color: #2a2a2a;\\r\\n    display: flex;\\r\\n    flex-direction: column;\\r\\n    gap: 10px;\\r\\n}\\r\\n\\r\\n/* Toast Alert */\\r\\n.toast-alert {\\r\\n    position: fixed;\\r\\n    bottom: 20px;\\r\\n    left: 50%;\\r\\n    transform: translateX(-50%);\\r\\n    background-color: #333;\\r\\n    color: white;\\r\\n    padding: 10px 20px;\\r\\n    border-radius: 5px;\\r\\n    z-index: 1000;\\r\\n    display: none; /* Hidden by default, shown by JS */\\r\\n    opacity: 0;\\r\\n    transition: opacity 0.5s ease-in-out;\\r\\n}\\r\\n\\r\\n/* Upload Modal */\\r\\n.upload-modal {\\r\\n    position: fixed;\\r\\n    top: 50%;\\r\\n    left: 50%;\\r\\n    transform: translate(-50%, -50%);\\r\\n    background-color: white;\\r\\n    border-radius: 8px;\\r\\n    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);\\r\\n    padding: 20px;\\r\\n    width: 100%;\\r\\n    width: 100%;\\r\\n    max-width: 500px;\\r\\n    z-index: 999;\\r\\n    z-index: 999;\\r\\n    display: none; /* Hidden by default, shown by JS */\\r\\n    box-sizing: border-box;\\r\\n}\\r\\n\\r\\n.upload-modal-close {\\r\\n    position: absolute;\\r\\n    top: 10px;\\r\\n    right: 10px;\\r\\n    font-size: 1.5em;\\r\\n    cursor: pointer;\\r\\n    color: #555;\\r\\n}\\r\\n\\r\\n.upload-header h2 {\\r\\n    margin-top: 0;\\r\\n    margin-bottom: 20px;\\r\\n    margin-bottom: 20px;\\r\\n    text-align: center;\\r\\n    color: #333;\\r\\n}\\r\\n\\r\\n.upload-container {\\r\\n    position: relative;\\r\\n    border: 2px dashed #656565;\\r\\n    position: relative;\\r\\n    border: 2px dashed #656565;\\r\\n    border-radius: 8px;\\r\\n    display: flex;\\r\\n    flex-direction: column;\\r\\n    justify-content: center;\\r\\n    align-items: center;\\r\\n    cursor: pointer;\\r\\n    min-height: 200px;\\r\\n    max-height: max-content; /* Fixed height for consistency */\\r\\n    min-height: 200px;\\r\\n    max-height: max-content; /* Fixed height for consistency */\\r\\n    position: relative;\\r\\n    overflow: hidden;\\r\\n    object-fit: contain;\\r\\n    object-fit: contain;\\r\\n}\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n#upload-text {\\r\\n    display: flex;\\r\\n    width: 100%;\\r\\n    display: flex;\\r\\n    width: 100%;\\r\\n    color: #777;\\r\\n    font-size: 1em;\\r\\n    font-weight: 500;\\r\\n    position: relative;\\r\\n    cursor: pointer;\\r\\n    font-size: 1em;\\r\\n    font-weight: 500;\\r\\n    position: relative;\\r\\n    cursor: pointer;\\r\\n}\\r\\n\\r\\n.upload-preview {\\r\\n    position: relative;\\r\\n    position: relative;\\r\\n    max-width: 100%;\\r\\n    max-height: 100%;\\r\\n    object-fit: contain;\\r\\n    display: none; /* Hidden by default, shown when image is selected */\\r\\n    background:#007bff;\\r\\n    background:#007bff\\r\\n}\\r\\n\\r\\n.upload-details {\\r\\n    display: flex;\\r\\n    flex-direction: column;\\r\\n    margin-top: 8px;\\r\\n    margin-top: 8px;\\r\\n    gap: 10px;\\r\\n}\\r\\n\\r\\n.upload-details input[type=\\\"text\\\"],\\r\\n.upload-details textarea {\\r\\n    width: 100%;\\r\\n    padding: 10px;\\r\\n    border: 1px solid #ccc;\\r\\n    border-radius: 4px;\\r\\n    box-sizing: border-box;\\r\\n    font-size: .9em;\\r\\n    font-size: .9em;\\r\\n}\\r\\n\\r\\n.upload-details textarea {\\r\\n    min-height: fit-content;\\r\\n    max-height: 100px;\\r\\n    min-height: fit-content;\\r\\n    max-height: 100px;\\r\\n    resize: vertical;\\r\\n    overflow: auto;\\r\\n    overflow: auto;\\r\\n}\\r\\n\\r\\n.btn {\\r\\n    background-color: #007bff;\\r\\n    color: white;\\r\\n    padding: 10px 15px;\\r\\n    border: none;\\r\\n    border-radius: 5px;\\r\\n    cursor: pointer;\\r\\n    font-size: 1em;\\r\\n    text-align: center;\\r\\n    transition: background-color 0.3s ease;\\r\\n}\\r\\n\\r\\n.btn:hover {\\r\\n    background-color: #0056b3;\\r\\n}\\r\\n\\r\\n.spinner {\\r\\n    border: 3px solid rgba(255, 255, 255, 0.3);\\r\\n    border-top: 3px solid #fff;\\r\\n    border-radius: 50%;\\r\\n    width: 16px;\\r\\n    height: 16px;\\r\\n    animation: spin 1s linear infinite;\\r\\n    display: none; /* Hidden by default, shown by JS */\\r\\n}\\r\\n\\r\\n@keyframes spin {\\r\\n    0% { transform: rotate(0deg); }\\r\\n    100% { transform: rotate(360deg); }\\r\\n}\\r\\n\\r\\n\\r\\n\\r\\n/* Model Container (where the Three.js scene will render) */\\r\\n#model-container {\\r\\n  position: absolute;\\r\\n  top: 0;\\r\\n  left: 0;\\r\\n  width: 100dvw;\\r\\n  height: 100dvh;\\r\\n  overflow: hidden;\\r\\n  z-index: 1;\\r\\n  font-family: Arial, Helvetica, sans-serif;\\r\\n  user-select: none;\\r\\n}\\r\\n\\r\\n\\r\\n.expanded-annotation {\\r\\n    position: absolute;\\r\\n    left: 30px;\\r\\n    padding: 0px;\\r\\n    width: 0px;\\r\\n    height: 0px;\\r\\n    min-width: 0px;\\r\\n    overflow: hidden;\\r\\n    color: #fff;\\r\\n    border-radius: 5px;\\r\\n    background-color: #000000e4;\\r\\n    transition: width 0.4s, min-width 0.4s, height 0.4s;\\r\\n    z-index: 5;\\r\\n    display: flex;\\r\\n    flex-direction: column;\\r\\n    cursor: default;\\r\\n}\\r\\n\\r\\n.annotation:hover .expanded-annotation {\\r\\n    width: 250px;\\r\\n    height: 200px;\\r\\n    padding: 10px;\\r\\n    min-width: 100px;\\r\\n    border: 1px solid #fff;\\r\\n}\\r\\n\\r\\n.ImageShowContainer{\\r\\n    width: 100%;\\r\\n    height: 100%;\\r\\n    position: absolute;\\r\\n    top: 0;\\r\\n    left: 0;\\r\\n    overflow: hidden;\\r\\n    scrollbar-width: none;\\r\\n    z-index: 1005;\\r\\n    justify-content: space-between;\\r\\n    justify-items: auto;\\r\\n    /* From https://css.glass */\\r\\n    background: rgba(132, 130, 130, 0.54);\\r\\n    border-radius: 16px;\\r\\n    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);\\r\\n    -webkit-backdrop-filter: blur(7.7px);\\r\\n    backdrop-filter: blur(7.7px);\\r\\n    border: 1px solid rgba(132, 130, 130, 0.49);\\r\\n}\\r\\n\\r\\n.CancelBtnContainer{\\r\\n    font-size: large;\\r\\n    font-weight: 700;\\r\\n    margin-left: -10px;\\r\\n}\\r\\n\\r\\n.display_image_closeBtn{\\r\\n    font-size: 2rem;\\r\\n    font-weight: 500;\\r\\n    color: orangered;\\r\\n}\\r\\n\\r\\n.Seperator{\\r\\n    border-radius: 20px;\\r\\n    height: 1px;\\r\\n    color: black;\\r\\n    background-color: black;\\r\\n}\\r\\n\\r\\n .SecondIMGCol{\\r\\n    border: 1.4px solid black;\\r\\n    border-radius: 5%;\\r\\n}\\r\\n\\r\\n\\r\\n.FirstIMGCol img{\\r\\n    border: 8px solid rgb(6, 5, 5);\\r\\n    border-radius: 2%;\\r\\n}\\r\\n\\r\\n.TitleContainer {\\r\\n    font-weight: 800;\\r\\n}\\r\\n.BottomContainer{\\r\\n    font-weight: 500;\\r\\n}\\r\\n\"\n__vite__updateStyle(__vite__id, __vite__css)\nimport.meta.hot.accept()\nimport.meta.hot.prune(() => __vite__removeStyle(__vite__id))"
