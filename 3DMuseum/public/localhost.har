          "content": {
            "size": 38114,
            "mimeType": "text/javascript",
            "text": "\n      console.log(window.innerWidth, window.devicePixelRatio);\n      import { initI18next, updateContent, changeLanguage } from \"/src/i18next.js\";\n      import landingPageHTML from \"/template/landingpage_template.js\";\n      import { initializeGame } from \"/src/game_logic/index.js?t=1754216730225\";\n      import { initGalleryPage } from \"/src/gallery_logic.js\";\n      import { Museum } from \"/src/game_logic/constants.js\";\n      import WebWorker from \"/src/game_logic/web_worker.js?t=1754216610949&worker\";\n      localStorage.setItem('language', 'vi');\n      let galleryContainer = null;\n      initI18next().then(() => {\n        // After i18next is ready, load landing page HTML and update translations\n        document.getElementById('landingpage').innerHTML = landingPageHTML;\n        updateContent();\n\n        // CALL THE WEB_WORKER SO IT CAN LOAD IN THE BACKGROUND AND GIVE ALREADY DATA WHEN THE GAME STARTS\n        window.preloadData = null; // Initialize global preloadData to null and then then pass to the index.js\n        \n        const preloadWorker = new WebWorker();\n        preloadWorker.onerror = (error) => {\n          console.error('Error in web worker:', error);\n        };\n        preloadWorker.postMessage({\n          type: 'loadModel',\n          modelPath: `/assets/optimizedModel/optimizeModel_4.glb`, // Adjust the path to your model\n          museumId: Museum.ART_GALLERY,\n          roomId: Museum.ART_GALLERY\n        });\n\n        preloadWorker.onmessage = (event) => {\n          if (event.data.type === 'modelProcessed') {\n            console.log('Model data received from worker:', event.data);\n            window.preloadData = event.data;\n          } else if (event.data.type === 'error') {\n            console.error('Error loading model in worker:', event.data.data.message);\n            return;\n          }\n        };\n        // --- MOVED AND CORRECTED CODE ---\n        // Now that the landing page is in the DOM, we can safely find the button\n        const startButton = document.getElementById('start_button');\n        const generalContainer = document.getElementById('landingpageContainer');\n        const modelContainer = document.getElementById('model-container');\n        const menuContainer = document.getElementById('menu-container');\n\n        // Handle 3D game start\n        if (startButton) {\n          startButton.addEventListener('click', () => {\n            if(generalContainer) generalContainer.style.display = 'none';\n            if(modelContainer) modelContainer.style.display = 'block';\n            if(menuContainer) menuContainer.style.display = 'flex';\n            requestAnimationFrame(() => {\n              initializeGame('model-container', window.preloadData);\n            });\n          });\n        } else {\n          console.error('Start button still not found. Check template IDs.');\n        }\n\n        // Handle Gallery navigation\n        // const galleryLink = document.getElementById('gallery');\n        // if (galleryLink) {\n        //   galleryLink.addEventListener('click', (e) => {\n        //     e.preventDefault();\n        //     // Hide landing page, show gallery\n        //     if (!galleryContainer) {\n        //       galleryContainer = document.createElement('div');\n        //       galleryContainer.id = 'gallery-main-container';\n        //       galleryContainer.style.width = '100vw';\n        //       galleryContainer.style.height = '100vh';\n        //       galleryContainer.style.background = '#fff';\n        //       galleryContainer.style.position = 'absolute';\n        //       galleryContainer.style.top = '0';\n        //       galleryContainer.style.left = '0';\n        //       galleryContainer.style.zIndex = '1000';\n        //       document.body.appendChild(galleryContainer);\n        //     }\n        //     if(generalContainer) generalContainer.style.display = 'none';\n        //     if(modelContainer) modelContainer.style.display = 'none';\n        //     if(menuContainer) menuContainer.style.display = 'none';\n        //     galleryContainer.style.display = 'block';\n        //     initGalleryPage(galleryContainer);\n        //   });\n        // }\n      });\n\n      window.changeLanguage = changeLanguage;\n\n      // Change button visibility based on language\n      const vietBtn = document.querySelector('.VietBtn');\n      const enBtn = document.querySelector('.EnBtn');\n      let currentLanguage = 'vi';\n      enBtn.addEventListener('click', () => {\n        if(currentLanguage === 'en'){\n          vietBtn.innerHTML = 'VI';\n          enBtn.innerHTML = 'EN';\n          currentLanguage = 'vi';\n          localStorage.setItem('language', 'vi');\n          changeLanguage('vi');\n        }else if (currentLanguage === 'vi'){\n          vietBtn.innerHTML = 'EN';\n          enBtn.innerHTML = 'VI';\n          currentLanguage = 'en';\n          localStorage.setItem('language', 'en');\n          changeLanguage('en');\n        }\n      });\n\n  \n//# sourceMappingURL=data:application/json;base64,"
          },
